# ClimateShield Environment Variables Example
# Copy this file to .env and populate with your credentials.
# NEVER commit .env to Git!

# Server Ports
PORT=4001
GOVERNMENT_BACKEND_URL=http://172.19.39.31:4000/api
RESCUE_BACKEND_URL=http://localhost:4001/api

# Optional AI / LLM Configuration
# Set GEMINI_API_KEY to generate live AI Tactical Mission Dossiers for Rescue units
GEMINI_API_KEY=your_gemini_api_key_here

# Optional Live Weather & Satellite Telemetry (OpenWeatherMap / NOAA)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Optional Mapbox GL Vector Tiles & GPS Navigation
MAPBOX_TOKEN=pk.your_mapbox_public_token_here

# Supabase Shared Database Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key
