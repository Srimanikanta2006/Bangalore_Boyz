# ============================================================
# ClimateShield backend - environment configuration
# Copy to .env and fill in real values. NEVER commit real secrets.
# ============================================================

# --- Server ---
PORT=4000
NODE_ENV=development

# --- PostgreSQL (local Docker - default) ---
# Start the database with:  docker compose up -d   (see docker-compose.yml)
# Both URLs point at the same local instance (no pgBouncer locally).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/climateshield
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/climateshield

# --- PostgreSQL (hosted Supabase - optional alternative) ---
# To use Supabase instead of the local container, replace the two URLs above:
# Use the POOLED connection (pgBouncer, port 6543) for runtime app queries and
# the DIRECT connection (port 5432) ONLY for Prisma migrations / admin ops.
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10
# DIRECT_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=12h

# --- CORS ---
# Comma separated list of allowed frontend origins, or * for development only
CORS_ORIGIN=*

# --- Demo seed data ---
# Password assigned to the seeded demo accounts (documented in README.md)
DEMO_USER_PASSWORD=DemoGov@2024

# --- Live weather provider (Open-Meteo: no API key required) ---
WEATHER_PROVIDER=OPEN_METEO
WEATHER_API_KEY=
# Short-lived in-memory cache for live weather responses (0 disables caching)
WEATHER_CACHE_SECONDS=300
# Background polling of zone coordinates for dashboard/history (0 disables)
WEATHER_POLL_INTERVAL_MINUTES=10
# Optional: override the Overpass endpoint used by `npm run import:chennai` (no API key required)
# OVERPASS_URL=https://overpass-api.de/api/interpreter

# --- P4 AI explanation layer (Google Gemini) ---
# Get a key at https://aistudio.google.com/app/apikey
# Leave GEMINI_API_KEY BLANK to use the deterministic fallback (no external call, still works).
# NEVER commit a real key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

