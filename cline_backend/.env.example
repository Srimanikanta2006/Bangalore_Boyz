# ============================================================
# ClimateShield backend - environment configuration
# Copy to .env and fill in real values. NEVER commit real secrets.
# ============================================================

# --- Server ---
PORT=4000
NODE_ENV=development

# --- Supabase PostgreSQL ---
# Use the POOLED connection (pgbouncer, port 6543) for runtime app queries.
# Supabase -> Project Settings -> Database -> Connection string -> URI (Transaction pooler)
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10

# Use the DIRECT connection (port 5432) ONLY for Prisma migrations / admin ops.
# Supabase -> Project Settings -> Database -> Connection string -> URI (Session/irect)
DIRECT_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# For local development with the provided docker container you can simply use:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/climateshield
# DIRECT_URL=postgresql://postgres:postgres@localhost:5432/climateshield

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=12h

# --- CORS ---
# Comma separated list of allowed frontend origins, or * for development only
CORS_ORIGIN=*

# --- Demo seed data ---
# Password assigned to the seeded demo accounts (documented in README.md)
DEMO_USER_PASSWORD=DemoGov@2024

# --- Live weather provider (Open-Meteo: no API key required) ---
WEATHER_PROVIDER=OPEN_METEO
WEATHER_API_KEY=
# Short-lived in-memory cache for live weather responses (0 disables caching)
WEATHER_CACHE_SECONDS=300
# Background polling of zone coordinates for dashboard/history (0 disables)
WEATHER_POLL_INTERVAL_MINUTES=10

# --- P4 AI explanation layer (Google Gemini) ---
# Get a key at https://aistudio.google.com/app/apikey
# Leave GEMINI_API_KEY BLANK to use the deterministic fallback (no external call, still works).
# NEVER commit a real key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
